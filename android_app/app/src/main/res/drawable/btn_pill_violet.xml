<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_violet_dark"
                android:endColor="@color/accent_violet" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_violet"
                android:endColor="@color/accent_violet_dark" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>

