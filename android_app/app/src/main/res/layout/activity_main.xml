<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con Diseno Azul Pastel Cielo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginRight="14dp"
                android:contentDescription="Icono Shimeji" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PinkChan Shimeji"
                    android:textColor="@color/accent_sky"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mascota flotante para Android"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta 1: Permiso de Superposicion -->
        <LinearLayout
            android:id="@+id/card_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Permiso de Superposicion"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_permission_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_status_warn"
                    android:text="PENDIENTE"
                    android:textColor="@color/error_color"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="10dp"
                    android:paddingTop="3dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permite que el Shimeji se sobreponga y camine encima de tus otras aplicaciones en pantalla."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_grant_permission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_accent"
                android:text="CONCEDER PERMISO DE SUPERPOSICION"
                android:textColor="@color/bg_dark"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tarjeta 2: Control de Servicio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Control de Shimeji"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_shimeji"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_accent"
                    android:text="INICIAR"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_stop_shimeji"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_danger"
                    android:text="DETENER"
                    android:textColor="@color/error_color"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_center_shimeji"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_outline"
                android:text="Centrar en pantalla"
                android:textColor="@color/accent_sky"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tarjeta 3: Seleccion de Skin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personaje (Skin)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_skins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_konata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Konata Izumi (Lucky Star)"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_bocchi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bocchi-chan (Bocchi the Rock!)"
                    android:textColor="@color/text_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_monika"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monika (DDLC)"
                    android:textColor="@color/text_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_natsuki"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Natsuki (DDLC)"
                    android:textColor="@color/text_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_sayori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sayori (DDLC)"
                    android:textColor="@color/text_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_yuri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yuri (DDLC)"
                    android:textColor="@color/text_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Tarjeta 4: Ajustes de Tamano y Movimiento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamano y Movimiento"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escala del personaje:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rg_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_size_small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pequeno"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_size_normal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Normal"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grande"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cb_zero_gravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo Flotante (Gravedad Cero)"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tip: Manten presionado al Shimeji en pantalla para abrir su menu de acciones."
                android:textColor="@color/accent_sky"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Tarjeta 5: Multi-Shimeji en Pantalla -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-Shimeji (Varios en Pantalla)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Puedes invocar hasta 6 Shimejis simultaneos. Cada uno se mueve, interactua y deambula libremente."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_shimeji"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_accent"
                    android:text="+ AGREGAR OTRO (+1)"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_clear_extras"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_outline"
                    android:text="QUITAR EXTRAS"
                    android:textColor="@color/accent_sky"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta 6: Asistente de Voz y Control de Apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistente de Voz y Control de Apps"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca el boton y habla. Tambien puedes activarlo manteniendo presionado al Shimeji en pantalla."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_voice_assistant"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_accent"
                android:text="HABLAR CON EL SHIMEJI"
                android:textColor="@color/bg_dark"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comandos de voz disponibles:"
                android:textColor="@color/accent_sky"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Saludos: 'hola', 'buenos dias', 'que tal'&#10;* Hora: 'que hora es', 'hora'&#10;* Abrir Apps: 'abre whatsapp', 'abre youtube', 'abre camara', 'abre chrome', 'abre calculadora', 'abre ajustes'&#10;* Acciones: 'guitarra', 'caja', 'salta', 'flotar', 'acariciar'&#10;* Multi-Shimeji: 'invoca otro', 'clonar', 'limpiar extras'&#10;* Detener: 'detener', 'cerrar', 'adios'"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Tarjeta 7: Acciones Rapidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acciones en Vivo"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_action_guitar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/chip_action_bg"
                    android:text="Guitarra"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_action_box"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/chip_action_bg"
                    android:text="Caja"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_action_talk"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/chip_action_bg"
                    android:text="Hablar"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
