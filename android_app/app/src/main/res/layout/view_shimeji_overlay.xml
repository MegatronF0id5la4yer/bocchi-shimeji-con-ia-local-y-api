<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Menu de interaccion al mantener presionado (Long Press) -->
    <LinearLayout
        android:id="@+id/shimeji_longpress_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_bubble_bg"
        android:padding="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:id="@+id/tv_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interacciones de Shimeji"
            android:textColor="@color/accent_sky"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Fila 1: Asistente, Skin, Acariciar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/btn_menu_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Asistente"
                android:textColor="@color/accent_sky"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_skin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Skin"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_pet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Acariciar"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <!-- Fila 2: Guitarra, Caja, Clonar (+1) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/btn_menu_guitar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Guitarra"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Caja"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_clone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="+1 Clon"
                android:textColor="@color/accent_sky"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <!-- Fila 3: Flotar, Quitar, Cerrar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_menu_gravity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Flotar"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Quitar"
                android:textColor="@color/error_color"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btn_menu_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_action_bg"
                android:text="Cerrar"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bocadillo de dialogo flotante -->
    <TextView
        android:id="@+id/shimeji_speech_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/speech_bubble_bg"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxWidth="220dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:elevation="6dp" />

    <!-- Sprite animado del Shimeji -->
    <ImageView
        android:id="@+id/shimeji_image_view"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Shimeji" />

</LinearLayout>
